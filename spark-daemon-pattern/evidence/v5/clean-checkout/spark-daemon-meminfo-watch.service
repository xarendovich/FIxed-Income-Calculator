# Generated by spark-daemon-pattern 0.5.0 from <scratchpad>/clean/repo/spark-daemon-pattern/examples/meminfo-watch/manifest.json
# manifest sha256 b300618d57fda86630edd6853fa26b5ba7fe81b7f4317c1e99bccf1473e0ca03
# QUALIFIED by a battery PASS: projected from its report by `spark-daemon unit --report`.
# Any edit to it, or to the files it names, stops it from starting.
# Do not edit by hand: change the manifest and regenerate. Review before installing.

[Unit]
Description=Spark daemon meminfo-watch: Records when unified-memory headroom moves between bands, from /proc/meminfo and memory pressure (PSI).
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/python3 -I -B <scratchpad>/clean/repo/spark-daemon-pattern/bin/spark-daemon run --manifest <scratchpad>/clean/repo/spark-daemon-pattern/examples/meminfo-watch/manifest.json --expect-manifest-sha256 b300618d57fda86630edd6853fa26b5ba7fe81b7f4317c1e99bccf1473e0ca03 --expect-daemon-code-sha256 cb5c9d74a1337f206b3ad4d555c8d8fd4127a4dd6c803aa96e3e309836ffc077 --expect-contract-sha256 2d080b407b6c82b230563670746f4a615b2c96660ec68f4509574562c282001d
User=spark-meminfo
Group=spark-meminfo
Environment=SPARK_DAEMON_HOME=/root
WatchdogSec=90
TimeoutStartSec=90
TimeoutStopSec=100
Restart=on-failure
RestartPreventExitStatus=2 65 73 78
RestartSec=10
UMask=0077

# Resources
CPUWeight=10
MemoryMax=64M
TasksMax=8
IOSchedulingClass=idle
Nice=10

# Filesystem: everything read-only except the output directory; denied paths invisible
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/root/spark-daemons/meminfo-watch
InaccessiblePaths=-/root/spark-core/data -/root/spark-governance/history -/root/.ssh -/root/.gnupg -/root/.claude -/root/.codex
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible

# Network: none (manifest network.mode = none)
PrivateNetwork=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX

# Privileges and kernel
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
SystemCallArchitectures=native
SystemCallFilter=@system-service
# Landlock (runtime.py applies it at start-up); @system-service does not include @sandbox
SystemCallFilter=landlock_create_ruleset landlock_add_rule landlock_restrict_self
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
