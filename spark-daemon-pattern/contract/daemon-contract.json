{
  "schema": "spark-daemon-contract/1",
  "contract_version": "1.0.0",
  "contract_sha256": "ef03a744961cfad81abced56b0c12b18b222ce3219d779e5f6f79a64319fb585",
  "skeleton_version": "0.3.0",
  "contract": {
    "manifest": {
      "schema_id": "urn:spark:schema:spark-daemon-manifest:1",
      "manifest_schema": "spark-daemon-manifest/1",
      "json_schema_sha256": "62c25d9813adc44c7838ea244f081c0eddff0f98f40f37f45465694756ba0474",
      "max_bytes": 65536,
      "base_deny": [
        "~/spark-core/data",
        "~/spark-governance/history",
        "~/.ssh",
        "~/.gnupg",
        "~/.claude",
        "~/.codex"
      ],
      "forbidden_output_roots": [
        "~/spark-core",
        "~/spark-governance",
        "~/.ssh",
        "~/.gnupg",
        "~/.claude",
        "~/.codex"
      ],
      "forbidden_commands": [
        "ash",
        "at",
        "awk",
        "bash",
        "batch",
        "bun",
        "busctl",
        "busybox",
        "capsh",
        "cc",
        "chgrp",
        "chmod",
        "chown",
        "chroot",
        "clang",
        "cp",
        "crontab",
        "csh",
        "csplit",
        "curl",
        "dash",
        "dbus-send",
        "dd",
        "deno",
        "doas",
        "docker",
        "ed",
        "emacs",
        "env",
        "ex",
        "expect",
        "find",
        "fish",
        "flock",
        "ftp",
        "gawk",
        "gcc",
        "gdb",
        "gpg",
        "gpg2",
        "halt",
        "install",
        "ionice",
        "ip",
        "iptables",
        "irb",
        "java",
        "kill",
        "killall",
        "ksh",
        "ld",
        "less",
        "ln",
        "loginctl",
        "ltrace",
        "make",
        "man",
        "mawk",
        "mkdir",
        "mkfifo",
        "mknod",
        "mksh",
        "more",
        "mount",
        "mv",
        "nano",
        "nawk",
        "nc",
        "ncat",
        "netcat",
        "nft",
        "nice",
        "nmcli",
        "nohup",
        "npm",
        "npx",
        "nsenter",
        "nvim",
        "openssl",
        "parallel",
        "patch",
        "pip",
        "pip3",
        "pkexec",
        "pkill",
        "podman",
        "poweroff",
        "pwsh",
        "reboot",
        "rm",
        "rmdir",
        "rsync",
        "runuser",
        "scp",
        "script",
        "sed",
        "setpriv",
        "setsid",
        "sftp",
        "sh",
        "shred",
        "shutdown",
        "socat",
        "split",
        "sqlite3",
        "ssh",
        "stdbuf",
        "strace",
        "su",
        "sudo",
        "systemctl",
        "systemd-run",
        "tar",
        "tclsh",
        "tcsh",
        "tee",
        "telnet",
        "timeout",
        "touch",
        "toybox",
        "truncate",
        "umount",
        "unshare",
        "unzip",
        "vi",
        "vim",
        "watch",
        "wget",
        "wish",
        "xargs",
        "zip",
        "zsh"
      ],
      "forbidden_command_prefixes": [
        "python",
        "pypy",
        "perl",
        "node",
        "ruby",
        "php",
        "lua",
        "tcl",
        "java",
        "busybox"
      ],
      "reserved": {
        "daemon_class": [
          "act"
        ],
        "trigger.kind": [
          "inotify-wakeup"
        ],
        "network.mode": [
          "named"
        ]
      },
      "cross_field_rules": [
        "step_timeout_seconds must be at most half of watchdog_seconds",
        "run_as.user is required for unit 'system', must not be 'root', and is refused for unit 'user'",
        "paths are compared after expanding '~' (SPARK_DAEMON_HOME, else HOME) and resolving symlinks",
        "every read path must lie outside every denied path (base deny plus the manifest's deny)",
        "output_dir must not lie inside, or contain, ~/spark-core, ~/spark-governance, a base-deny path or a path in the manifest's deny",
        "output_dir must not overlap any read path (a daemon never observes its own output)"
      ]
    },
    "code": {
      "file": "daemon.py",
      "max_bytes": 262144,
      "required_functions": [
        {
          "name": "sense",
          "positional_args": 1,
          "signature": "sense(ctx) -> snapshot (plain data: None, bool, int, str, list, dict)"
        },
        {
          "name": "decide",
          "positional_args": 2,
          "signature": "decide(prev, snapshot) -> [(event_type, payload_dict), ...]"
        }
      ],
      "optional_functions": [
        {
          "name": "digest",
          "positional_args": 2,
          "signature": "digest(snapshot, recent) -> [(title, [(label, value), ...]), ...]"
        }
      ],
      "io_rule": "sense() is the only place with I/O, and only through ctx; decide() and digest() are pure",
      "allowed_imports": [
        "__future__",
        "bisect",
        "collections",
        "dataclasses",
        "enum",
        "functools",
        "hashlib",
        "heapq",
        "itertools",
        "json",
        "math",
        "operator",
        "re",
        "statistics",
        "string",
        "textwrap",
        "typing"
      ],
      "forbidden_builtins": [
        "__import__",
        "breakpoint",
        "compile",
        "delattr",
        "eval",
        "exec",
        "exit",
        "getattr",
        "globals",
        "help",
        "input",
        "locals",
        "open",
        "print",
        "quit",
        "setattr",
        "vars"
      ],
      "forbidden_names": [
        "Formatter",
        "ForwardRef",
        "attrgetter",
        "get_field",
        "get_type_hints",
        "methodcaller"
      ],
      "forbidden_attributes": [
        "ag_await",
        "ag_code",
        "ag_frame",
        "co_code",
        "co_consts",
        "co_names",
        "cr_await",
        "cr_code",
        "cr_frame",
        "cr_origin",
        "f_back",
        "f_builtins",
        "f_code",
        "f_globals",
        "f_lasti",
        "f_locals",
        "f_trace",
        "func_globals",
        "gi_code",
        "gi_frame",
        "gi_running",
        "gi_yieldfrom",
        "mro",
        "tb_frame",
        "tb_lasti",
        "tb_next",
        "with_traceback"
      ],
      "import_time_calls_allowed": [
        "Counter",
        "Enum",
        "Flag",
        "IntEnum",
        "IntFlag",
        "NamedTuple",
        "OrderedDict",
        "StrEnum",
        "TypeVar",
        "auto",
        "bool",
        "bytes",
        "cache",
        "chr",
        "compile",
        "dataclass",
        "defaultdict",
        "deque",
        "dict",
        "enumerate",
        "field",
        "frozenset",
        "int",
        "len",
        "list",
        "lru_cache",
        "max",
        "min",
        "namedtuple",
        "ord",
        "partial",
        "range",
        "reversed",
        "set",
        "sorted",
        "str",
        "sum",
        "total_ordering",
        "tuple",
        "unique",
        "zip"
      ],
      "other_rules": [
        "no dunder names or attributes; no private attributes (names starting with '_')",
        "no format string that reaches a dunder field",
        "no global or nonlocal; state flows only through prev and snapshot",
        "no async code; no star or relative imports",
        "top level: imports, def, class, constant assignments and a docstring only",
        "sense, decide and digest are each defined once with def, undecorated, never reassigned"
      ]
    },
    "values": {
      "types": [
        "null",
        "bool",
        "int",
        "str",
        "list",
        "dict (str keys)"
      ],
      "floats": "refused everywhere; use integers with a stated unit (permille, basis points, kB)",
      "int_range": [
        -9007199254740991,
        9007199254740991
      ],
      "canonical_form": "RFC 8785 (JCS) for every accepted value; UTF-8; no lone surrogates"
    },
    "ctx": {
      "methods": [
        {
          "name": "disk_usage",
          "call": "ctx.disk_usage(path)",
          "params": [
            {
              "name": "path",
              "type": "str"
            }
          ],
          "returns": "DiskUsage",
          "summary": "Total, free and available bytes of the filesystem holding a declared path."
        },
        {
          "name": "git",
          "call": "ctx.git(repo, args, max_bytes=65536, index_copy=False)",
          "params": [
            {
              "name": "repo",
              "type": "str"
            },
            {
              "name": "args",
              "type": null
            },
            {
              "name": "max_bytes",
              "type": "int",
              "default": 65536
            },
            {
              "name": "index_copy",
              "type": "bool",
              "default": false
            }
          ],
          "returns": "RunResult",
          "summary": "Run a read-only Git subcommand (proc.GIT_SUBCOMMANDS) in a declared repository."
        },
        {
          "name": "list_dir",
          "call": "ctx.list_dir(path, max_entries=1024)",
          "params": [
            {
              "name": "path",
              "type": "str"
            },
            {
              "name": "max_entries",
              "type": "int",
              "default": 1024
            }
          ],
          "returns": "Listing",
          "summary": "Sorted entry names of a directory; truncated=True past max_entries."
        },
        {
          "name": "now_utc",
          "call": "ctx.now_utc()",
          "params": [],
          "returns": "str",
          "summary": "Wall-clock time, informational only; never use it to order events."
        },
        {
          "name": "read_text",
          "call": "ctx.read_text(path, max_bytes=65536)",
          "params": [
            {
              "name": "path",
              "type": "str"
            },
            {
              "name": "max_bytes",
              "type": "int",
              "default": 65536
            }
          ],
          "returns": "str",
          "summary": "Read a text file (UTF-8, invalid bytes replaced). Raises TooLarge past max_bytes."
        },
        {
          "name": "run",
          "call": "ctx.run(argv, max_bytes=65536)",
          "params": [
            {
              "name": "argv",
              "type": null
            },
            {
              "name": "max_bytes",
              "type": "int",
              "default": 65536
            }
          ],
          "returns": "RunResult",
          "summary": "Run one of the manifest's commands (argv list, never a shell). Git is refused here: it must go through ctx.git(), which enforces the read-only subcommand and option rules."
        },
        {
          "name": "stat",
          "call": "ctx.stat(path)",
          "params": [
            {
              "name": "path",
              "type": "str"
            }
          ],
          "returns": "StatInfo",
          "summary": "Kind (\"file\", \"dir\", \"link\" or \"other\"), size and mtime_us; symlinks are not followed."
        }
      ],
      "results": [
        {
          "name": "StatInfo",
          "fields": [
            {
              "name": "kind",
              "type": "str"
            },
            {
              "name": "size",
              "type": "int"
            },
            {
              "name": "mtime_us",
              "type": "int"
            }
          ]
        },
        {
          "name": "DiskUsage",
          "fields": [
            {
              "name": "total_bytes",
              "type": "int"
            },
            {
              "name": "free_bytes",
              "type": "int"
            },
            {
              "name": "available_bytes",
              "type": "int"
            }
          ]
        },
        {
          "name": "Listing",
          "fields": [
            {
              "name": "names",
              "type": "tuple"
            },
            {
              "name": "truncated",
              "type": "bool"
            }
          ]
        },
        {
          "name": "RunResult",
          "fields": [
            {
              "name": "returncode",
              "type": "int | None"
            },
            {
              "name": "stdout",
              "type": "str"
            },
            {
              "name": "truncated",
              "type": "bool"
            },
            {
              "name": "timed_out",
              "type": "bool"
            }
          ]
        }
      ],
      "exceptions": [
        {
          "name": "ctx.Missing",
          "summary": "The path does not exist (a normal condition a daemon may handle)."
        },
        {
          "name": "ctx.TooLarge",
          "summary": "The content exceeds the requested bound."
        },
        {
          "name": "ctx.NotAllowed",
          "summary": "The request is outside the manifest. Counted as a policy violation: the daemon stops with exit 78 after the cycle even if its own code catches this."
        }
      ],
      "writes": "none: ctx has no method that writes, deletes, sends or executes anything outside the manifest's commands"
    },
    "git": {
      "via": "ctx.git(repo, args, max_bytes=65536, index_copy=False); ctx.run(['git', ...]) is refused",
      "subcommands": [
        "blame",
        "cat-file",
        "count-objects",
        "describe",
        "diff",
        "diff-files",
        "diff-index",
        "diff-tree",
        "for-each-ref",
        "log",
        "ls-files",
        "ls-tree",
        "merge-base",
        "name-rev",
        "rev-list",
        "rev-parse",
        "shortlog",
        "show",
        "show-ref",
        "status"
      ],
      "diff_subcommands_forced_flags": {
        "subcommands": [
          "diff",
          "diff-files",
          "diff-index",
          "diff-tree",
          "log",
          "show"
        ],
        "flags": [
          "--no-ext-diff",
          "--no-textconv"
        ]
      },
      "refused_long_options": [
        "--output",
        "--no-index",
        "--ext-diff",
        "--textconv",
        "--exec",
        "--upload-pack",
        "--receive-pack",
        "--contents",
        "--ignore-revs-file",
        "--exclude-from",
        "--exclude-per-directory",
        "--pathspec-from-file",
        "--open-files-in-pager",
        "--orderfile",
        "--mailmap-file",
        "--show-signature",
        "--verify-signatures",
        "--stdin",
        "--batch",
        "--filters"
      ],
      "refused_short_options": {
        "blame": [
          "-S"
        ],
        "diff": [
          "-O"
        ],
        "diff-files": [
          "-O"
        ],
        "diff-index": [
          "-O"
        ],
        "diff-tree": [
          "-O"
        ],
        "log": [
          "-O"
        ],
        "ls-files": [
          "-X"
        ],
        "show": [
          "-O"
        ]
      },
      "other_rules": [
        "the subcommand is always the first argument",
        "no argument may be absolute, start with '~' or contain a '..' segment",
        "no %G signature placeholders in --format/--pretty",
        "safe.directory is set to exactly the declared repository"
      ],
      "global_options_always_set": [
        "--no-pager",
        "-c",
        "color.ui=never",
        "-c",
        "core.fsmonitor=false",
        "-c",
        "core.quotepath=off",
        "-c",
        "core.pager=cat"
      ]
    },
    "digest": {
      "label_pattern": "^[A-Za-z0-9][A-Za-z0-9 .,:()/%+-]{0,63}$",
      "row_value_types": [
        "str",
        "int",
        "bool",
        "null"
      ],
      "containment": "every value is rendered inside a fenced code block with visible escapes"
    },
    "ledger": {
      "schema": "spark-daemon-ledger/1",
      "reserved_event_types": [
        "DAEMON_START",
        "DAEMON_STOP",
        "DAEMON_ERROR",
        "DAEMON_ERROR_CLEARED",
        "LEDGER_TAIL_QUARANTINED"
      ],
      "event_type_pattern": "^[A-Z][A-Z0-9_]{2,47}$",
      "output_dir_entries": [
        "daemon.lock",
        "digest.md",
        "ledger.jsonl",
        "quarantine",
        "tmp"
      ],
      "ledger_file": "ledger.jsonl",
      "digest_file": "digest.md"
    },
    "exit_codes": {
      "0": "stopped cleanly",
      "2": "bad manifest, impure code, or daemon code failed to import",
      "65": "corrupt ledger; nothing changed",
      "70": "uncertain ledger commit; recovery decides on restart",
      "73": "another instance holds the lock",
      "78": "unsafe output directory, Landlock refused, or a policy violation (fail closed)"
    },
    "evidence": {
      "validate": {
        "schema": "spark-daemon-validate/1",
        "cost": "milliseconds",
        "checks": "manifest schema and cross-field rules, purity, candidate envelope"
      },
      "precheck": {
        "schema": "spark-daemon-precheck/1",
        "cost": "about 2 seconds",
        "checks": "validate, plus a short confined run under Landlock with the audit hook recording, ledger provenance, and unit lint"
      },
      "battery": {
        "schema": "spark-daemon-battery/1",
        "cost": "about 15 seconds",
        "checks": [
          "DB-01",
          "DB-02",
          "DB-03",
          "DB-04",
          "DB-05",
          "DB-06",
          "DB-07",
          "DB-08",
          "DB-09",
          "DB-10",
          "DB-11",
          "DB-12",
          "DB-13",
          "DB-14",
          "DB-15",
          "DB-16",
          "DB-17",
          "DB-18"
        ],
        "admissible": true
      },
      "admissible_for_activation": "battery PASS only, then a human Class C ruling"
    },
    "candidate": {
      "schema": "spark-daemon-candidate/1",
      "file": "candidate.json"
    },
    "authority": "A candidate carries no authority. Whoever or whatever produced it - a person, a script or a model - it cannot certify itself: validate and precheck are fast feedback, the conformance battery's PASS is the only admissible evidence, and activation remains a human Class C decision. A producer is never granted authority that no one adjudicated."
  }
}
