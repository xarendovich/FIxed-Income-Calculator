{
  "manifest_schema": "spark-daemon-manifest/4",
  "version": "0.1.0",
  "purpose": "Test fixture daemon for the skeleton self-tests.",
  "daemon_class": "observe",
  "trigger": {
    "kind": "poll",
    "interval_seconds": 5
  },
  "reads": [
    "~/data"
  ],
  "network": {
    "mode": "none"
  },
  "run_as": {
    "unit": "user"
  },
  "resources": {
    "cpu_weight": 10,
    "cpu_budget_bp": 100,
    "memory_max_mb": 64,
    "tasks_max": 8,
    "io_class": "idle"
  },
  "cycle_budget_seconds": 5,
  "blind_limit_seconds": 600,
  "ledger": {
    "record_max_bytes": 8192,
    "event_types": [
      "VALUE_OBSERVED",
      "VALUE_CHANGED"
    ]
  },
  "digest": {
    "enabled": true,
    "max_bytes": 8192
  },
  "name": "fixture-raiser",
  "output_dir": "~/out/raiser"
}
